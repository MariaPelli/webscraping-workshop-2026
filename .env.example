# Lokal: Kopiere diese Datei einmalig nach .env.
# Falls Port 4444 bereits belegt ist, verwende z. B. 4445.
# Danach: docker compose up -d
SELENIUM_PORT=4444

# In Codespaces setzt die Container-Konfiguration die interne URL automatisch.
# SELENIUM_REMOTE_URL hier NICHT auf localhost setzen.
# Der Einrichtungstest und alle synthetischen Beispiele benoetigen keine Keys.

# OPTIONAL: nur fuer die explizit aktivierten Live-Abfragen in Demo 2.
# Werte nur in Deiner lokalen .env eintragen, niemals in Notebooks oder Git.
# Vorhandene .env beim Update behalten und diese Zeilen bei Bedarf ergaenzen.
COINGECKO_DEMO_API_KEY=
FLICKR_API_KEY=
# Fuer die gezeigte oeffentliche Flickr-Suche ist kein API-Secret erforderlich.
